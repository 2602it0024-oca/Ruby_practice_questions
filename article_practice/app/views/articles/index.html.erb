<% if notice.present? %>
  <p class="message-success"><%= notice %></p>
<% end %>

<% if alert.present? %>
  <p class="message-delete"><%= alert %></p>
<% end %>

<h1>投稿一覧</h1>

<%= link_to "新規投稿", new_article_path %>

<table class="article-table">
  <thead>
    <tr>
      <th>タイトル</th>
      <th>投稿内容</th>
    </tr>
  </thead>

  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= link_to article.title, article_path(article) %></td>
        <td><%= article.content %></td>
      </tr>
    <% end %>
  </tbody>
</table>