<h1>新規投稿</h1>

<%= form_with model: @article, data: { turbo: false } do |form| %>
  <p>
    <%= form.label :title, "タイトル" %><br>
    <%= form.text_field :title %>
  </p>

  <p>
    <%= form.label :content, "投稿内容" %><br>
    <%= form.text_area :content %>
  </p>

  <%= form.submit "投稿" %>
<% end %>

<%= link_to "一覧に戻る", articles_path %>