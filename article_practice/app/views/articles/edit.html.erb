<h1>投稿編集</h1>

<%= form_with model: @article, data: { turbo: false } do |form| %>
  <div>
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content, "投稿内容" %>
    <%= form.text_area :content %>
  </div>

  <%= form.submit "投稿更新" %>
<% end %>

<%= link_to "投稿詳細へ戻る", article_path(@article) %>